{
  "name": "mooncellar",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "bun@1.3.12",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^26.1.1",
      "axios": "^1.20.0",
      "eslint": "9.39.5",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-prettier": "^5.5.6",
      "jwt-decode": "^4.0.0",
      "typescript": "5.9.3",
      "typescript-eslint": "^8.64.0",
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "dev": "bun run dev:api & bun run dev:web & bun run dev:game & wait",
    "dev:api": "bun --filter api start:dev",
    "dev:web": "bun --filter web dev",
    "dev:game": "bun --filter game start:dev",
    "build": "bun --filter '*' build",
    "lint": "bun --filter '*' lint",
    "mongo": "ssh -f -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 27017:localhost:27017 root@31.57.201.233",
    "mongo:stop": "pkill -f 'ssh .*-L 27017:localhost:27017' || true",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "docs": "vitepress dev docs --port 4333",
    "docs:build": "vitepress build docs",
    "storybook": "bun --filter web storybook"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "multer": "^2.5.0"
  }
}

{
  "name": "game",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "bun run typecheck && bun run check:boot",
    "typecheck": "tsc -p tsconfig.build.json",
    "check:boot": "bun scripts/check-boot.ts",
    "test": "bun test src",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "lint": "eslint src --ext ts --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@mooncellar/schemas": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "11.4.2",
    "@nestjs/throttler": "^6.7.1",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "express": "^5.2.1",
    "mongoose": "8.24.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "pino-http": "^11.0.0",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
